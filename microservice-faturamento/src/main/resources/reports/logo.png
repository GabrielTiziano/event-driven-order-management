<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 200" width="640" height="200" font-family="DejaVu Sans, Arial, sans-serif">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4F46E5"/>
      <stop offset="1" stop-color="#14B8A6"/>
    </linearGradient>
  </defs>

  <!-- tile -->
  <rect x="24" y="36" width="128" height="128" rx="30" fill="url(#g)"/>

  <!-- mesh links -->
  <g stroke="#ffffff" stroke-width="3.5" stroke-opacity="0.92" stroke-linecap="round">
    <line x1="88" y1="100" x2="60" y2="68"/>
    <line x1="88" y1="100" x2="118" y2="72"/>
    <line x1="88" y1="100" x2="64" y2="132"/>
    <line x1="88" y1="100" x2="120" y2="128"/>
  </g>

  <!-- mesh nodes -->
  <g fill="#ffffff">
    <circle cx="60" cy="68" r="8"/>
    <circle cx="118" cy="72" r="8"/>
    <circle cx="64" cy="132" r="8"/>
    <circle cx="120" cy="128" r="8"/>
    <circle cx="88" cy="100" r="14"/>
  </g>
  <circle cx="88" cy="100" r="6" fill="url(#g)"/>

  <!-- wordmark -->
  <text x="184" y="97" font-size="50" font-weight="bold" fill="#0F172A">Gabriel Tiziano</text>
  <text x="186" y="137" font-size="21" font-weight="bold" fill="#0E9488" letter-spacing="7">MICROSERVICES</text>
</svg>
